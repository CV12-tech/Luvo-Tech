{"id": "a16a285a-a86a-45ac-9a6c-6306c7da76d2", "ocid": "ocds-mnwr74-b3e49dd7-7708-4cd3-9da4-43eab1770326", "tag": ["tender"], "datum": "2023-12-03", "url": "https://oeffentlichevergabe.de/ui/de/search/details?noticeId=a16a285a-a86a-45ac-9a6c-6306c7da76d2", "api_eforms": "https://oeffentlichevergabe.de/api/notices/a16a285a-a86a-45ac-9a6c-6306c7da76d2?format=eforms", "auftraggeber": "Stadt Bernau bei Berlin", "auftraggeber_ort": "Bernau bei Berlin", "nuts": ["DE405"], "ausfuehrungsort": ["Bernau bei Berlin"], "titel": "Los 3-11 Tischlerarbeiten Erweiterung und Sanierung Schulstandort GSH Bernau", "beschreibung": "Die Grundschule \"An der Hasenheide\" wird durch einen unterkellerten viergeschossigen Riegelbau in Massivbauweise und einer eingeschossigen Mensa/Aula entlang der Krimhildstraße erweitert. Die Anbindung an die Bestandsbauten erfolgt durch einen neu zu errichtenden dreigeschossigen Fluranbau. Folgende Maßnahmen sollen durchgeführt werden: - Lieferung und Einbau von Einbauschränken verschiedener Größen und Teilungen - Herstellen und Montage der Holz- Sitzflächen der Bänke in den Fluren - Herstellen und Einbau Fenster- Brüstungskästen aus Holz, innen - Einbau von Holzhandläufen in beiden Treppenhäusern", "lose": "Los 3-11 Tischlerarbeiten Erweiterung und Sanierung Schulstandort GSH Bernau", "los_details": [{"id": "LOT-0001", "titel": "Los 3-11 Tischlerarbeiten Erweiterung und Sanierung Schulstandort GSH Bernau", "wert": null, "start": null, "ende": null}], "cpv": ["45214200"], "wert": null, "verfahren": "Open", "kategorie": null, "unterlagen": ["https://vergabemarktplatz.brandenburg.de/VMPSatellite/notice/CXP9YHV6N3B/documents"], "zuschlaege": [], "fit": 16, "treffer": ["mensa(ausstattung|einrichtung|möbel|küche|umbau|sanierung)?", "tischlerarbeiten"], "land": "DE4"}
