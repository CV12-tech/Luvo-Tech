{"id": "e35fe2b1-f23a-4d02-afa9-ace327ef35af", "ocid": "ocds-mnwr74-5eb91cd5-ef70-4127-87b6-2662e82d8290", "tag": ["award"], "datum": "2025-12-29", "url": "https://oeffentlichevergabe.de/ui/de/search/details?noticeId=e35fe2b1-f23a-4d02-afa9-ace327ef35af", "api_eforms": "https://oeffentlichevergabe.de/api/notices/e35fe2b1-f23a-4d02-afa9-ace327ef35af?format=eforms", "auftraggeber": "Kreisausschuss Main-Taunus-Kreis, Hochbau- und Liegenschaftsamt", "auftraggeber_ort": "Hofheim am Taunus", "nuts": ["DE71A"], "ausfuehrungsort": ["Hofheim"], "titel": "EMG-2025 - Zimmermannsbeiten - ExPost", "beschreibung": "Der Main-Taunus-Kreis beabsichtigt einen Neubau als Mensa- und Betreuungseinrichtung der Marxheimer Grundschule zu errichten. Der gesamte Neubau orientiert sich an den vormaligen Bestandshöhen und Kubaturen und fügt sich in den Dorf-Charakter, der umliegenden historischen Umgebung der Marxheimer Altstadt ein. Die vier neuen Satteldachgebäude werden mit einem eingeschossigen Flachdachgebäude als Erdgeschoss und mit einem Untergeschoss und Tiefhöfen miteinander verbunden. Der Neubau wird in Hybridbauweise aus Massiv- und Holzbauteilen erstellt.   Gebäudeklasse: 3 (Sonderbau). Geschosse: 1,5 Vollgeschosse, unterkellert. Bauweise: Stahlbeton, KS-Mauerwerk und Holzrahmenbau. Abmessung B x L x H: 25,36 m x 35,74 m x 9,12 m (Firsthöhe).", "lose": "EMG-2025 - Zimmermannsbeiten - ExPost", "los_details": [{"id": "LOT-0001", "titel": "EMG-2025 - Zimmermannsbeiten - ExPost", "wert": null, "start": "2026-03-23T00:00:00+01:00", "ende": "2026-10-30T00:00:00+01:00"}], "cpv": ["45422000"], "wert": 316275.61, "verfahren": "Open", "kategorie": "works", "unterlagen": [], "zuschlaege": [{"lieferant": null, "lieferant_ort": "", "wert": null, "datum": "", "los": ["LOT-0001"]}], "fit": 12, "treffer": ["mensa(ausstattung|einrichtung|möbel|küche|umbau|sanierung)?"], "land": "DE7"}
