on\nInhalt der Urkalkulation: Dies", "lose": "65_Neues Rathaus Dresden. FL 3277 - Tischlerarbeiten Empfangstresen Ostflügel", "los_details": [{"id": "LOT-0000", "titel": "65_Neues Rathaus Dresden. FL 3277 - Tischlerarbeiten Empfangstresen Ostflügel", "wert": null, "start": null, "ende": null}], "cpv": ["45", "43", "44", "71"], "wert": null, "verfahren": "Public announcement", "kategorie": null, "unterlagen": ["https://www.evergabe.de/auftraege/suche-ueber-vergabestellen/Landeshauptstadt%2520Dresden/3091055"], "zuschlaege": [], "fit": 16, "treffer": ["tresen", "tischlerarbeiten"], "land": "DED"}
