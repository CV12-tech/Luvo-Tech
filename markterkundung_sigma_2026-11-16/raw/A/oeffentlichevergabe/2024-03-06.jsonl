{"id": "21691934", "ocid": "ocds-mnwr74-21691934", "tag": ["tender"], "datum": "2024-03-04", "url": "https://oeffentlichevergabe.de/ui/de/search/details?noticeId=21691934", "api_eforms": "https://oeffentlichevergabe.de/api/notices/21691934?format=eforms", "auftraggeber": "Staatliches Bau- und Liegenschaftsamt Schwerin", "auftraggeber_ort": null, "nuts": ["DE8"], "ausfuehrungsort": ["19055 Schwerin"], "titel": "beabsichtigte beschränkte Auschreibung 24B0058S, Staatliches Museum Schwerin, Tischlerleistungen", "beschreibung": "Staatliches Museum Schwerin, Galeriegebäude, 3. BA, Flankierende Maßnahmen\nTischlerleistungen\nVergabe-Nr. 24B0058S\nArt und Umfang der Leistung:\nIm Rahmen der Modernisierung der Innenraumausstattung des Galeriegebäudes des Staatlichen Museums Schwerin werden Tischlerleistungen ausgeschrieben. Zu den Hauptleistungen gehören die Herstellung der Einrichtung des Museumsshops mit Cafétresen sowie vier Informationsmodule mit zwei Tickettresen in den beiden Foyers und 15 Sitzbänken für die Ausstellungsflächen.\nOrt der Ausführung: 19055 Schwerin\nAusführungszeitraum: 16.09.2024 - 15.11.2024\nInteressenbekundungen bis 11.03.2024 an zvs@fm.sbl-mv.de\n\nTischler", "lose": "beabsichtigte beschränkte Auschreibung 24B0058S, Staatliches Museum Schwerin, Tischlerleistungen", "los_details": [{"id": "LOT-0000", "titel": "beabsichtigte beschränkte Auschreibung 24B0058S, Staatliches Museum Schwerin, Tischlerleistungen", "wert": null, "start": null, "ende": null}], "cpv": ["45", "43", "44", "71"], "wert": null, "verfahren": null, "kategorie": null, "unterlagen": [], "zuschlaege": [], "fit": 24, "treffer": ["museumsshop", "tresen"], "land": "DE8"}
