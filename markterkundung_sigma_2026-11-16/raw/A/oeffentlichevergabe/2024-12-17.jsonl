{"id": "17c6dd96-418d-46eb-9d46-b0dfcfd687ce", "ocid": "ocds-mnwr74-e227a096-339d-4d17-8640-0c15db846556", "tag": ["award"], "datum": "2024-12-15", "url": "https://oeffentlichevergabe.de/ui/de/search/details?noticeId=17c6dd96-418d-46eb-9d46-b0dfcfd687ce", "api_eforms": "https://oeffentlichevergabe.de/api/notices/17c6dd96-418d-46eb-9d46-b0dfcfd687ce?format=eforms", "auftraggeber": "AOK-Bundesverband eGbR - Arbeitsgemeinschaft von Körperschaften des öffentlichen Rechts", "auftraggeber_ort": "Berlin", "nuts": ["DE300"], "ausfuehrungsort": ["Berlin"], "titel": "BüvA_Loses Mobiliar und sonstige Einrichtungsgegenstände", "beschreibung": "Das bereits in den Jahren 2020 und 2022/2023 umgesetzte Gesamtraumkonzept soll fortgeführt werden. Das \"lose Mobiliar\" ist Teil des Designkonzeptes und soll optisch und organisatorisch ein geschlossenes Einrichtungsprogramm bilden. Alle Elemente müssen funktional, technisch, organisatorisch, ergonomisch und formal eine Einheit darstellen und so gestaltet sein, dass sie auch frei im Raum aufgestellt und ggf. nach Bedarf auch jederzeit umgezogen werden können. Aus diesem Grund erfolgt eine produktbezogene Ausschreibung mit Produkten folgender Hersteller:  Brunner, Vitra, CHAT BOARD(R), MUUTO, Johanson Design, Cor, de Vorm, Object Carpet, Bene, Creation Baumann, Grid, Zilenzio, Framery, Wilkhahn, Werner Works", "lose": "BüvA_Loses Mobiliar und sonstige Einrichtungsgegenstände", "los_details": [{"id": "LOT-0001", "titel": "BüvA_Loses Mobiliar und sonstige Einrichtungsgegenstände", "wert": null, "start": null, "ende": null}], "cpv": ["39150000"], "wert": null, "verfahren": "Open", "kategorie": "goods", "unterlagen": [], "zuschlaege": [{"lieferant": null, "lieferant_ort": "", "wert": null, "datum": "2024-10-28", "los": ["LOT-0001"]}], "fit": 0, "treffer": [], "land": "DE3"}
