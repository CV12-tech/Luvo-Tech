{"id": "28b5452f-1e31-42c6-af2f-54893c61f12b", "ocid": "ocds-mnwr74-6168f0d1-a4f3-4f00-a6bb-68aa25874e66", "tag": ["tender"], "datum": "2024-12-15", "url": "https://oeffentlichevergabe.de/ui/de/search/details?noticeId=28b5452f-1e31-42c6-af2f-54893c61f12b", "api_eforms": "https://oeffentlichevergabe.de/api/notices/28b5452f-1e31-42c6-af2f-54893c61f12b?format=eforms", "auftraggeber": "Klinikum Region Hannover GmbH", "auftraggeber_ort": "Hannover", "nuts": ["DE929"], "ausfuehrungsort": ["Hannover"], "titel": "Neubau KRH-Zentralapotheke, Funktionsschrankanlagen", "beschreibung": "Die Klinikum Region Hannover GmbH plant am Campus Klinikum Siloah in Hannover den Neubau einer Zentralapotheke (ZAPO), welche die zur KRH gehörigen Krankenhäuser und weitere externe Kliniken mit den notwendigen Medikamenten versorgt. Die heutige Zentralapotheke auf der Liegenschaft Siloah ist derzeit in zwei Gebäuden (Bauteile O und J) untergebracht. Mit dem Neubau sollen zum einen die baulichen Defizite der veralteten Gebäude beseitigt werden und zum anderen die getrennte Funktionseinheit  zusammengefügt werden, um einen zeitgemäßen modernen Betrieb einer Zentralapotheke zu ermöglichen.", "lose": "Neubau KRH-Zentralapotheke, Funktionsschrankanlagen", "los_details": [{"id": "LOT-0001", "titel": "Neubau KRH-Zentralapotheke, Funktionsschrankanlagen", "wert": null, "start": "2025-03-17T00:00:00+01:00", "ende": "2026-04-17T00:00:00+02:00"}], "cpv": ["45421153"], "wert": null, "verfahren": "Open", "kategorie": null, "unterlagen": ["https://www.dtvp.de/Satellite/notice/CXP4DLS5HNB/documents"], "zuschlaege": [], "fit": 0, "treffer": [], "land": "DE9"}
